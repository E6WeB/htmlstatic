---
import { createRequire } from 'node:module';
import path from 'node:path';
const require = createRequire(path.join(process.cwd(), 'package.json'));
const { getSiteContext } = require('./src/lib/site-context.js');
const { getCategoryHtml } = require('./src/lib/pages-content.js');

export function getStaticPaths() {
  const req = createRequire(path.join(process.cwd(), 'package.json'));
  const { getSiteContext: getCtx } = req('./src/lib/site-context.js');
  return getCtx().categories.map(cat => ({
    params: { slug: cat.slug },
    props: { cat }
  }));
}

const { cat } = Astro.props;
const html = getCategoryHtml(getSiteContext(), cat);
---
<Fragment set:html={html} />
