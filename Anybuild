load(
    "//anybuild/tools:node.bzl",
    "node_build",
    "node_config",
    "node_serve",
)

config = node_config(
    schema = 1,
    commands = {
        "build": "npm run build && npm install --prefix .server pg geoip-lite --no-save",
        "start": "node serve.js",
    },
    node_version = "24",
)

build = node_build(config)
node_serve(config, build, name = "staticstack")
